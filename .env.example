# .env.example
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git

# ============================================
# DATABASE (MongoDB)
# ============================================
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bakery?retryWrites=true&w=majority

# ============================================
# PAYPAL CONFIGURATION
# ============================================
# Get from: https://developer.paypal.com/dashboard
# For testing, use sandbox credentials
# For production, use live credentials

# PayPal Client ID
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Client Secret (KEEP THIS PRIVATE!)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal API URL
# Sandbox: https://api-m.sandbox.paypal.com
# Production: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (get from webhook settings in PayPal dashboard)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ============================================
# NEXT AUTH CONFIGURATION
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_generated_secret_here

# Your application URL
NEXTAUTH_URL=http://localhost:3000

# ============================================
# JWT CONFIGURATION
# ============================================
# Secret for signing JWT tokens
JWT_SECRET=your_jwt_secret_here

# ============================================
# PUBLIC VARIABLES (can be exposed to frontend)
# ============================================
# PayPal Client ID for frontend (same as above, but prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For sending order confirmation emails
# SENDGRID_API_KEY=your_sendgrid_api_key

# ============================================
# STRIPE CONFIGURATION (Optional, for future)
# ============================================
# STRIPE_PUBLIC_KEY=your_stripe_public_key
# STRIPE_SECRET_KEY=your_stripe_secret_key

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
